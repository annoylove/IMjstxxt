# ===== IM 服务端环境配置模板 =====
# 复制为 .env 后按需修改

NODE_ENV=development
PORT=3100

# 存储模式：
#   fallback — 零依赖（Node 内置 SQLite + JSON 文件 + 内存 Map），开箱即跑
#   real     — 真实中间件（MySQL + MongoDB + Redis），需先启动对应服务
STORAGE_MODE=fallback
# fallback 模式数据目录（相对 server 运行目录）
DATA_DIR=data

# ===== JWT =====
# 生产环境务必替换为随机长字符串
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===== MySQL（STORAGE_MODE=real 时生效）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=im_system

# ===== MongoDB（STORAGE_MODE=real 时生效）=====
MONGO_URI=mongodb://127.0.0.1:27017/im_messages

# ===== Redis（STORAGE_MODE=real 时生效）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 可选：Socket.io 多实例横向扩展（需 Redis）=====
SOCKET_IO_REDIS_ADAPTER=false

# ===== 上传 =====
UPLOAD_DIR=public/uploads
MAX_IMAGE_SIZE=5242880
MAX_VOICE_SIZE=10485760

# ===== 客户端 API 地址（uni-app H5 代理目标，供参考）=====
# client/config.js 中的 BASE_URL 指向本服务的 /api/v1
